# Database
MONGODB_URI=mongodb://127.0.0.1:27017/sahiy_docs

# Authentication
AUTH_SECRET=your_next_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Environment
NODE_ENV=development

# Seed (birinchi admin foydalanuvchisi)
SEED_SECRET=your_seed_secret_here
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me

# Support/Call-Center - Telegram bot (BotFather orqali yaratiladi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SWEEP_SECRET=your_sweep_secret_here

# Support/Call-Center - Zadarma PBX integratsiyasi (qo'ng'iroq yozuvlari uchun)
# Zadarma shaxsiy kabinet > Sozlamalar > API va integratsiyalar bo'limidan olinadi
ZADARMA_API_KEY=
ZADARMA_API_SECRET=

# CRM browser/mobile push (Firebase Console > Project settings > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Yangi Firebase loyihasining service account JSON'i (bir qatorli JSON).
# Bo'sh bo'lsa legacy service-account fayli ishlatiladi.
FIREBASE_SERVICE_ACCOUNT_JSON=
