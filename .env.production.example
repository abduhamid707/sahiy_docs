# Sahiy CRM production environment namunasi.
# Bu faylga haqiqiy secret yozmang. Serverda undan `.env` nusxa oling.

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Auth
AUTH_SECRET=replace_with_openssl_rand_base64_32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://crm.sahiy.uz

# MongoDB (serverdagi Docker network hosti)
MONGODB_URI=mongodb://MONGO_USER:MONGO_PASSWORD@brend-mongo:27017/sahiy_docs?authSource=admin

# Telegram va CRM reminder worker
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_BOT_USERNAME=replace_with_bot_username
ENABLE_TELEGRAM_BOT=true
ENABLE_REMINDER_SWEEP=true
SWEEP_SECRET=replace_with_random_sweep_secret

# Firebase web config — browser bundle uchun build vaqtida ham uzatiladi
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_with_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_with_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=replace_with_measurement_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=replace_with_public_vapid_key

# Tavsiya: service-account JSON'ni bir qatorli JSON sifatida server `.env`ga yozing.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace_me"}
# Alternativa: container ichida mount qilingan fayl yo‘li.
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-admin.json

# Birinchi admin seed (faqat kerak bo‘lsa)
SEED_SECRET=replace_with_random_seed_secret
SEED_ADMIN_NAME=Sahiy Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_strong_password

# PBX integratsiyasi (ixtiyoriy)
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
