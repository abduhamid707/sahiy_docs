# ==============================================================================
# SAHIY DOCS / CRM PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# NextAuth v5 sozlamalari (openssl rand -base64 32)
AUTH_SECRET=your_32_character_random_auth_secret_here
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://docs.logistic.org.uz

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB)
# ------------------------------------------------------------------------------
# Docker tarmog'i ichidagi MongoDB URI (authSource=admin)
MONGODB_URI=mongodb://admin:your_mongo_password@brend-mongo:27017/sahiy_docs?authSource=admin

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT (Grammy - Eslatmalar va Support)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=8970855742:AAF734KzgSKFQv4pLsW3zwOkr5dudsimFmQ
TELEGRAM_BOT_USERNAME=sahiy_support_assistant_bot
ENABLE_TELEGRAM_BOT=true
ENABLE_REMINDER_SWEEP=true

# ------------------------------------------------------------------------------
# 4. FIREBASE CLOUD MESSAGING (Push Notifications)
# ------------------------------------------------------------------------------
# Web FCM Client (NEXT_PUBLIC_ prefix Next.js frontendiga uzatiladi)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sahiydocsfcm.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sahiydocsfcm
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sahiydocsfcm.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=849187313018
NEXT_PUBLIC_FIREBASE_APP_ID=1:849187313018:web:...
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BHLoN0b2nTyshjRQHRMtyihDuOS9-OZWMquI5MhrsLYXBSA7XlPm0eOV4941sZExRMKvRCch_HHNu9brjWntVPY

# Firebase Admin SDK (Serverdan push yuborish uchun Service Account JSON)
# JSON fayl yo'li yoki base64/JSON string sifatida uzatilishi mumkin:
FIREBASE_SERVICE_ACCOUNT_PATH=/app/sahiydocsfcm-firebase-adminsdk.json

# ------------------------------------------------------------------------------
# 5. INITIAL SUPER ADMIN (Faqat birinchi marta seed qilish uchun)
# ------------------------------------------------------------------------------
SEED_ADMIN_NAME="Sahiy Super Admin"
SEED_ADMIN_EMAIL=sahiy_admin@logistic.org.uz
SEED_ADMIN_PASSWORD=YourStrongSuperAdminPassword2026!
